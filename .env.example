# Agent API
AGENT_API_TOKEN=replace-with-a-random-string-when-creating-env
AGENT_API_PORT=8000
AGENT_API_HOST=0.0.0.0

# Tenant identifier (single-user local, gets real values in multi-tenant cloud)
TENANT_ID=local

# Ollama
OLLAMA_HOST=http://host.docker.internal:11434

# Storage backends
STORAGE_BACKEND=sqlite
SQLITE_PATH=/data/agent.sqlite

# Vector store
VECTOR_BACKEND=qdrant_local
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# Open WebUI
OPEN_WEBUI_PORT=3000

# Models (these match configs/models.yaml; env vars allow per-environment overrides)
MODEL_GENERAL=llama3.1:8b
MODEL_CODE=qwen2.5-coder:14b
MODEL_CODE_HEAVY=deepseek-coder-v2:16b
MODEL_EMBEDDING=nomic-embed-text

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Eval harness
EVAL_TIMEOUT_SECONDS=30
